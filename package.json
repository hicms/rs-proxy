{
  "name": "rs-proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/frontend.mjs dev",
    "build": "tsc --noEmit && node scripts/frontend.mjs build",
    "preview": "node scripts/frontend.mjs preview",
    "check": "tsc --noEmit",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run check:tests && playwright test",
    "test:e2e": "npm test --",
    "test:native": "pwsh -NoProfile -File tests/native/run.ps1",
    "test:standalone": "pwsh -NoProfile -File tests/native/standalone.ps1",
    "test:titlebar": "pwsh -NoProfile -File tests/native/titlebar.ps1",
    "test:installer": "pwsh -NoProfile -File tests/native/installer.ps1",
    "test:proxy": "cargo run -p proxy-engine --example check-live-proxy --",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@fontsource/figtree": "^5.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
